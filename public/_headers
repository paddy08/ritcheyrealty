# Cloudflare Workers static assets default to `Cache-Control: public,
# max-age=0, must-revalidate`, forcing a revalidation round-trip for every
# asset on every visit. These rules give repeat visitors real caching.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Next.js build output is content-hashed — safe to cache "forever".
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static media in /public isn't hashed. Lighthouse's cache-lifetime scoring
# only gives partial credit below ~1 month, so this is set to 30 days rather
# than the year given to the hashed build assets above — while this site is
# still being actively redesigned, files like hero.mp4 keep getting replaced
# under the same name, and a longer TTL would leave repeat visitors seeing a
# stale version for that much longer. Bump the filename (e.g. hero-v2.mp4)
# instead of relying on cache expiry when you replace one of these, and
# raise this once the asset set stops changing often.
/*.mp4
  Cache-Control: public, max-age=2592000

/*.webm
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000
