# Cloudflare Workers static assets default to `Cache-Control: public,
# max-age=0, must-revalidate`, forcing a revalidation round-trip for every
# asset on every visit. These rules give repeat visitors real caching.
# https://developers.cloudflare.com/workers/static-assets/headers/

# Next.js build output is content-hashed — safe to cache "forever".
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static media in /public isn't hashed, so keep this shorter: long enough to
# help repeat visits, short enough that a swapped file doesn't stay stale for
# a year. Bump the filename (e.g. hero-v2.mp4) instead of relying on cache
# expiry if you replace one of these.
/*.mp4
  Cache-Control: public, max-age=604800

/*.webm
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.jpg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800
